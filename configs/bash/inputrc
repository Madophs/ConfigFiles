$if gdb
    set editing-mode emacs
$else
    set editing-mode vi

    set show-mode-in-prompt

    # 30 is black foreground color
    # 96 is cyan foreground color
    # 49 is default background color
    # 106 is cyan background color
    # set vim insert mode string
    set vi-ins-mode-string \1\e[1;96;49m\2\1\e[1;30;106m\2INSERT\1\e[1;96;49m\2\1\e[0m\2

    # 30 is black foreground color
    # 92 is green foreground color
    # 102 is set background color to color 10
    # 40 is set background color to color 0
    # set vim command (normal) model string
    set vi-cmd-mode-string \1\e[1;92;49m\2\1\e[1;30;102m\2NORMAL\1\e[1;92;49m\2\1\e[0m\2
$endif
